{
  "name": "coda-writer-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Blog server for Coda Writer. Runs on Cloudflare Workers or Node.",
  "scripts": {
    "test": "vitest run",
    "check": "tsc --noEmit",
    "build": "esbuild src/node.ts --bundle --platform=node --format=esm --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.17",
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  }
}
